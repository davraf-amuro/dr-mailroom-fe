{
  "name": "dr-mailroom-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "lint:check": "oxlint . && eslint .",
    "format:check": "prettier --check src/",
    "gen:api": "openapi-typescript http://localhost:5180/openapi/v1.json -o src/services/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "~5.3.0",
    "@fontsource-variable/saira": "~5.3.0",
    "@lucide/vue": "~1.53.0",
    "@pinia/colada": "~1.4.8",
    "@pinia/colada-plugin-auto-refetch": "^0.2.7",
    "@vueuse/core": "~15.0.0",
    "echarts": "~6.1.0",
    "motion-v": "~2.6.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "reka-ui": "~2.11.0",
    "vue": "^3.5.42",
    "vue-echarts": "~8.3.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "~4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "~7.13.0",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "~5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
